# Canonical public URL of the deployed site.
# Used for the QR code and shared card links so they never point at
# Vercel preview deployments.
# Set VITE_SITE_URL in the Vercel dashboard
# (Project → Settings → Environment Variables) and redeploy —
# Vite inlines it at build time, so changing it requires a new build.
VITE_SITE_URL=https://maurice-cards.vercel.app
